# Andyur worker daemon image. Runs as a SPIFFE workload (worker role) on the
# containerized SPIRE domain, so it can authenticate to an identity-on control
# plane, and launches each run as a SIBLING container through the host's Docker
# socket (mounted at /var/run/docker.sock) -- hence the docker CLI here. It only
# talks HTTP to the server and shells out `docker run`; no db or model deps.
FROM python:3.12-slim
WORKDIR /app

# docker CLI (to launch/inspect runner containers) from Docker's apt repo
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg \
       | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && chmod a+r /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable" \
       > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends docker-ce-cli \
    && apt-get purge -y curl gnupg && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    "httpx>=0.27" "python-dotenv>=1.0" \
    "opentelemetry-sdk>=1.27" "opentelemetry-exporter-otlp-proto-http>=1.27" \
    "pyjwt>=2.8" "cryptography>=42" \
    "spiffe>=0.3,<0.4" \
    "kubernetes>=36.0,<37" \
    "starlette>=0.37,<1" \
    "temporalio>=1.33,<2"
# starlette: the Kubernetes launcher (kubernetes_manifests -> dataplane
# brokertransport -> envoyconfig -> extauthz) imports it. A fresh build without
# it could not import the controller at all -- found when the worker was
# rolled in-cluster (2026-08-26); the exec-input gate's in-image probe now
# imports the controller so this cannot recur silently.
# temporalio: this image also runs the engine's EXECUTION WORKER
# (andyur.orchestration.temporal.execution_worker, ADR-014 D11), which polls the
# engine's execution queue and launches through this same launcher. The worker
# daemon itself still never constructs a workflow provider.

COPY andyur ./andyur
ENTRYPOINT ["python", "-m", "andyur.daemon"]
