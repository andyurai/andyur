@@ -975,6 +975,17 @@ type TokenExchangeRequest struct {
 	// Resource is a URI that indicates the target service or resource where
 	// the client intends to use the requested security token.
 	Resource Resources
+	// RequestedScopes is the scope the client asked for, already parsed.
+	//
+	// Without this a policy running in the exchange handler cannot see what was
+	// requested, and the handler is the ONLY place that knows the subject -- it
+	// is what resolves the subject token. Scope, resource and authorization
+	// details are all validated before the handler runs, so a deployment that
+	// needs a subject-aware decision over them has nowhere to put it.
+	RequestedScopes []string
+	// RequestedAuthDetails is the RFC 9396 authorization_details the client
+	// asked for, already parsed, for the same reason.
+	RequestedAuthDetails []AuthDetail
