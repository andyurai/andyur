@@ -137,6 +137,10 @@ type authDetailsValidationOptions struct {
 
 // validateAuthDetails validates the auth details for the token request.
 func validateAuthDetails(ctx oidc.Context, req request, c *goidc.Client, opts *authDetailsValidationOptions) error {
+	if req.authDetailsMalformed {
+		return goidc.NewError(goidc.ErrorCodeInvalidAuthDetails,
+			"authorization_details is not a JSON array of objects")
+	}
