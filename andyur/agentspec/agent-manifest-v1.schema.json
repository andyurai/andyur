{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://andyur.ai/schemas/agent-manifest-v1.schema.json",
 "title": "AgentManifest v1",
 "description": "The developer-authored Andyur agent manifest. Requests are non-authoritative: platform policy decides what is granted, and compilation can only narrow. No secret is a legal value anywhere in a manifest. Governed mode additionally requires runtime.image.digest; that is an admission-mode rule, so digest is structurally optional here.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "apiVersion",
  "kind",
  "metadata",
  "runtime",
  "instructions"
 ],
 "properties": {
  "apiVersion": {
   "const": "andyur.ai/v1"
  },
  "kind": {
   "const": "Agent"
  },
  "metadata": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "name",
    "version"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^agt_[a-z0-9][a-z0-9_-]{1,62}$"
    },
    "name": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "version": {
     "type": "string",
     "pattern": "^\\d{1,9}(\\.\\d{1,9}){0,2}([-+][A-Za-z0-9.-]{1,32})?$"
    }
   }
  },
  "runtime": {
   "oneOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "type"
     ],
     "properties": {
      "type": {
       "const": "builtin-claude"
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "type",
      "image",
      "command",
      "interface"
     ],
     "properties": {
      "type": {
       "const": "container"
      },
      "image": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "ref"
       ],
       "properties": {
        "ref": {
         "type": "string",
         "pattern": "^[a-z0-9][a-z0-9._/:-]{0,254}$"
        },
        "digest": {
         "type": "string",
         "pattern": "^sha256:[0-9a-f]{64}$"
        }
       }
      },
      "command": {
       "type": "array",
       "minItems": 1,
       "maxItems": 64,
       "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
       }
      },
      "interface": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "protocol"
       ],
       "properties": {
        "protocol": {
         "enum": [
          "andyur-agent-runtime/v1",
          "exec/v1"
         ]
        }
       }
      },
      "resources": {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "cpu": {
         "type": "string",
         "pattern": "^\\d{1,20}(\\.\\d{1,6})?(m|k|M|G|T|Ki|Mi|Gi|Ti)?$"
        },
        "memory": {
         "type": "string",
         "pattern": "^\\d{1,20}(\\.\\d{1,6})?(m|k|M|G|T|Ki|Mi|Gi|Ti)?$"
        }
       }
      },
      "lifecycle": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "mode",
        "max_seconds"
       ],
       "properties": {
        "mode": {
         "enum": [
          "task"
         ]
        },
        "max_seconds": {
         "type": "integer",
         "minimum": 60,
         "maximum": 604800
        },
        "on_exit": {
         "enum": [
          "fail"
         ]
        }
       }
      },
      "process": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "input"
       ],
       "properties": {
        "input": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "mode"
         ],
         "properties": {
          "mode": {
           "enum": [
            "stdin",
            "argv",
            "file",
            "none"
           ]
          },
          "max_bytes": {
           "type": "integer",
           "minimum": 1,
           "maximum": 8388608
          }
         }
        },
        "output": {
         "type": "object",
         "additionalProperties": false,
         "properties": {
          "stdout": {
           "enum": [
            "capture",
            "discard"
           ]
          },
          "stderr": {
           "enum": [
            "capture",
            "discard"
           ]
          },
          "max_bytes": {
           "type": "integer",
           "minimum": 1,
           "maximum": 16777216
          }
         }
        }
       }
      },
      "configuration": {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "env": {
         "type": "object",
         "maxProperties": 64,
         "propertyNames": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
         },
         "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
           "literal": {
            "type": "string",
            "maxLength": 4096
           },
           "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
           }
          }
         }
        },
        "files": {
         "type": "array",
         "maxItems": 8,
         "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "path",
           "template"
          ],
          "properties": {
           "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
           },
           "template": {
            "type": "string",
            "maxLength": 65536
           }
          }
         }
        }
       }
      }
     }
    }
   ]
  },
  "instructions": {
   "type": "string",
   "minLength": 1,
   "maxLength": 32768
  },
  "model": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "requested"
   ],
   "properties": {
    "requested": {
     "type": "string",
     "minLength": 1
    },
    "access": {
     "enum": [
      "proxy"
     ]
    }
   }
  },
  "capabilities": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "tools": {
     "type": "array",
     "maxItems": 32,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "server",
       "tools"
      ],
      "properties": {
       "server": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{1,63}$"
       },
       "tools": {
        "type": "array",
        "minItems": 1,
        "maxItems": 128,
        "items": {
         "type": "string",
         "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        }
       }
      }
     }
    }
   }
  },
  "input": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "schema"
   ],
   "properties": {
    "schema": {
     "type": "string",
     "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:+-]{0,511}$"
    }
   }
  },
  "output": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "schema"
   ],
   "properties": {
    "schema": {
     "type": "string",
     "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:+-]{0,511}$"
    }
   }
  }
 }
}
