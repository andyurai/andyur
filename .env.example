# Andyur configuration. Copy to .env and adjust; .env is gitignored.
#
# Set only what you need to change: everything below has a working default for a
# local, single-node Andyur. The one variable that decides the shape of the
# deployment is first, because an earlier version of this file promised "an
# empty .env runs out of the box" and did not mention it at all.

# --- Deployment profile: the most consequential setting here ---
# prod (DEFAULT) refuses to start until containment is configured, and names
#   every missing control. That is the posture you want in production.
# dev runs bare on a trusted machine, with every containment control OFF.
#   ./run.sh up, server, daemon and broker default to dev so getting started
#   works; anything else inherits prod.
ANDYUR_PROFILE=dev

# One coherent installation shape; never inferred and never falls back.
#   native      control plane + agent runs are native processes (development)
#   docker      control plane + agent runs are Docker containers (single host)
#   kubernetes  control plane + agent runs are Kubernetes workloads
ANDYUR_DEPLOYMENT=native
# Kubernetes additionally requires:
# ANDYUR_KUBERNETES_NAMESPACE=andyur-runs
# ANDYUR_WORKER_ID=andyur-worker-0
# ANDYUR_KUBERNETES_PROXY_IMAGE=registry.example/andyur-proxy@sha256:...
# ANDYUR_KUBERNETES_AGENT_IMAGE=registry.example/andyur-agent@sha256:...
# LITELLM_MASTER_KEY=

# What prod additionally requires (each refused at startup if missing):
#   ANDYUR_DEPLOYMENT=docker|kubernetes (native is development-only)
#   ANDYUR_AGENT_AUTH=on           confine a run to its own agent
#   ANDYUR_SANDBOX_NETWORK=name    Docker only: INTERNAL run network
#   ANDYUR_DELEGATIONS=...         who may hand work to whom ("*" for everyone)
#   ANDYUR_BROKER_URL=...          when a provider API key is present
#   ANDYUR_RUN_TOKEN_SECRET=...    shared by every replica AND the broker

# --- LLM backend (who powers agent runs, and how it is billed) ---
# api (default) | subscription | ollama
ANDYUR_LLM=api
# Required only for ANDYUR_LLM=api. Never commit a real key.
ANTHROPIC_API_KEY=
# For ANDYUR_LLM=ollama: a pulled model with tool support and a large context.
ANDYUR_AGENT_MODEL=
ANDYUR_OLLAMA_URL=http://localhost:11434

# --- State store ---
# Empty = local SQLite. A postgres:// URL enables multi-node server replicas.
ANDYUR_DB_URL=

# --- The agent mind (storage) ---
# local (default, files on disk) | s3 (S3-compatible object store, e.g. MinIO)
ANDYUR_STORAGE=local
ANDYUR_S3_ENDPOINT=http://localhost:9000
ANDYUR_S3_BUCKET=andyur
ANDYUR_S3_ACCESS_KEY=minioadmin
ANDYUR_S3_SECRET_KEY=minioadmin
ANDYUR_S3_REGION=us-east-1

# --- Server bind (set HOST=0.0.0.0 when sandboxed runners must reach it) ---
ANDYUR_HOST=127.0.0.1
ANDYUR_PORT=8642

# --- Optional: container split, off by default ---
# How a headless run is executed (conversational runs are always in-process):
#   off      one process; the uid split is the boundary
#   process  two processes in one container: a sidecar holding the run token and
#            serving the tools over loopback HTTP + the model proxy, and a
#            credential-less agent process driving the SDK
#   pod      TWO CONTAINERS: the same split, but the agent gets its own container
#            joined to the sidecar's network namespace. The container boundary
#            replaces the uid split. Needs ANDYUR_SANDBOX=on.
# See docs/container-split-plan.md.
ANDYUR_AGENT_SPLIT=off
# Mint a per-run token for the loopback tool service and the A<->B channel
# (defense-in-depth for a shared network namespace). On by default when splitting.
ANDYUR_AGENT_SPLIT_TOKENS=on
# Pod mode only: the fixed loopback port the sidecar's A<->B channel binds. Must
# be fixed because the daemon tells the agent container where to connect before
# the sidecar exists. Safe as a constant -- each pod has its own netns.
ANDYUR_CHANNEL_PORT=8765
# How long the sidecar waits for the agent container to connect before failing
# the run closed (so a broken agent image does not hold a slot until the TTL).
ANDYUR_AGENT_CONNECT_TIMEOUT=120

# --- Optional: sandboxing, identity, tracing (all off by default) ---
ANDYUR_SANDBOX=off
ANDYUR_MTLS=off
# OFF here because tracing needs a collector to send to, and the
# getting-started path must not require infrastructure you do not have yet.
# Turn it on with `ANDYUR_OTEL=on` plus an OTLP endpoint (see
# docs/observability.md) -- every authorization decision the platform makes is
# a span, and running without them means a refusal you cannot explain
# afterwards. An EXPORTED value wins over this file, so a gate or a deployed
# profile that exports `ANDYUR_OTEL=on` is not overridden by a copied template.
ANDYUR_OTEL=off
# Trace the per-run authorization decision (SVID validate + token<->SVID bind) into
# the run's Jaeger trace. Verbose (authorization runs on hot paths), so it's separate
# from ANDYUR_OTEL and off by default; turn on to debug the identity flow.
ANDYUR_TRACE_AUTH=off
# Identity is always on, so agents must be sandboxed (ANDYUR_SANDBOX=on): otherwise
# an agent shares the runner's uid and could exec a peer role's binary to obtain
# its SVID. Set this to on to run identity-on WITHOUT a sandbox anyway (dev only).
ANDYUR_ALLOW_UNISOLATED_AGENT=off
# Bind the R1 run token to the caller's container-attested per-run SVID. A mismatched
# per-run SVID is always rejected when present; set this on to REQUIRE a matching
# per-run SVID on every run-scoped call (full enforcement). Needs identity + the
# containerized SPIRE stack (./run.sh spire-docker). See docs/agent-isolation-plan.md.
ANDYUR_REQUIRE_RUN_SVID=off

# --- Optional: user identity (multi-user; off by default) --------------------
# With user-auth ON, the owner-scoped API calls (create/list/get/trigger/pause/
# resume/delete + ceiling) carry a user's OIDC token (x-andyur-user-token): the
# validated user OWNS the agents they create, runs act for the owner, and other
# users cannot see them. The console signs the user in with the same Auth Code +
# PKCE flow as `andyur auth login`. ISSUER and AUDIENCE below are REQUIRED when
# this is on (the server refuses to start otherwise), because admin and
# ownership are read from the token and it must be validated against both.
# (Not yet user-scoped, and operator-SVID-gated: schedules, mind versions,
# run-token issuance, graph -- see ROADMAP.md gap 11.)
ANDYUR_USER_AUTH=off
# The user IdP (any OIDC provider; ./run.sh user-idp stands up a dev Keycloak).
ANDYUR_OIDC_ISSUER=
# Derived from the issuer's discovery document when unset.
ANDYUR_OIDC_JWKS=
ANDYUR_OIDC_AUDIENCE=
# ADMIN is an IdP-asserted role: a user whose token carries ANDYUR_ADMIN_ROLE in
# the claim at ANDYUR_ROLES_CLAIM (dot path; the default matches Keycloak realm
# roles) may see/manage every owner's agents and the ops surfaces (workers,
# workflow halt) -- but never trigger another owner's agent (no impersonation).
# Unset = nobody is admin (fail closed).
ANDYUR_ADMIN_ROLE=
ANDYUR_ROLES_CLAIM=realm_access.roles
# The OAuth client the CONSOLE logs in as (its own, distinct from the CLI's
# andyur-cli): Auth Code + PKCE only, no password grant, audience=andyur only.
# Point this at whatever client id you register for the console in your IdP; it
# needs a loopback redirect URI (http://127.0.0.1:8765-8769/callback). The
# default assumes the bundled dev realm (infra/keycloak/realm-andyur.json).
# NOTE: that bundled dev realm's andyur-cli client keeps the password grant
# (ROPC) ON for the test harnesses only -- a production realm should disable it
# (RFC 9700 sec 2.4). This knob does not close ROPC realm-wide; it only gives the
# console its own PKCE-only client.
ANDYUR_CONSOLE_CLIENT_ID=andyur-console
# Where the console links a run's trace: a URL template with {trace_id}.
# Empty = no link. The console never queries a tracing backend, it links out.
# ANDYUR_TRACE_UI_URL=http://localhost:16686/trace/{trace_id}

# --- Workflow engine (optional; the default needs none) ----------------------
# The ten-minute path uses the native engine: nothing to set here.
# ANDYUR_WORKFLOW_PROVIDER=local
# A durable engine instead (production Kubernetes deployments use it):
# ANDYUR_WORKFLOW_PROVIDER=temporal
# ANDYUR_TEMPORAL_ADDRESS=localhost:7233
# ANDYUR_TEMPORAL_NAMESPACE=default
# Who dispatches an admitted run (ADR-014 D11):
#   native  the engine tracks it; the worker daemon's assignment loop runs it
#   engine  the engine dispatches it to the execution worker
#           (python -m andyur.orchestration.temporal.execution_worker)
# ANDYUR_TEMPORAL_DISPATCH=native
# ANDYUR_TEMPORAL_EXECUTION_QUEUE=andyur-runs
# Concurrent executions per execution-worker replica (physical capacity only).
# ANDYUR_EXECUTION_CONCURRENCY=4

# --- Reference IdP (Docker; opt-in) ------------------------------------------
# `./run.sh idp up` runs a real Keycloak + its own PostgreSQL as a swappable
# reference component (compose profile `idp`). Keycloak sits on exactly two
# networks -- andyur-control (where the server reaches it) and the internal
# andyur-idp segment (its database) -- and never the run network, so an agent
# run has no route to it. Its secrets are GENERATED into data/docker.env on
# first up (never defaults; the compose service refuses to boot without
# them). Demo users are CREATED at setup, on the fly: `idp up` replaces the
# realm's bootstrap fixtures (alice/bob/carol) with freshly created users --
# passwords asked at the terminal (empty = generate) or generated when
# non-interactive, stored as ANDYUR_IDP_PASSWORD_ALICE/BOB/CAROL in
# data/docker.env -- and rotates the committed andyur-agent client secret to
# a generated value (ANDYUR_IDP_AGENT_CLIENT_SECRET). Nothing committed to
# the repo authenticates against the running reference. `./run.sh idp verify`
# proves the login and the reachability contract live. The bundled realm
# remains a demo (fixed usernames, ROPC on the andyur-cli test client), not a
# tenant directory -- production brings its own realm/IdP.
#
# Host port for the browser-facing issuer http://127.0.0.1:<port>/realms/andyur
# (set it in data/docker.env so compose and the token issuer stay one fact):
# ANDYUR_IDP_PORT=8480
# ANDYUR_IDP_ADMIN_USER=admin
#
# Wiring the server to it (any OIDC provider wires the same way):
#   Dockerized control plane (data/docker.env): issuer stays the browser URL,
#   JWKS is fetched in-network --
#     ANDYUR_USER_AUTH=on
#     ANDYUR_OIDC_ISSUER=http://127.0.0.1:8480/realms/andyur
#     ANDYUR_OIDC_JWKS=http://keycloak:8080/realms/andyur/protocol/openid-connect/certs
#     ANDYUR_OIDC_AUDIENCE=andyur
#     ANDYUR_ADMIN_ROLE=andyur-admin
#   Native server (.env): same, except JWKS is reached via the issuer itself --
#     ANDYUR_OIDC_JWKS=http://127.0.0.1:8480/realms/andyur/protocol/openid-connect/certs
# ANDYUR_OIDC_JWKS is MANDATORY with Keycloak: when unset the server derives
# <issuer>/.well-known/jwks.json, a path Keycloak does not serve (its keys live
# under /protocol/openid-connect/certs), so every login would 404 confusingly.
#
# State semantics: the realm JSON is imported only into a FRESH IdP database,
# and the generated DB password is baked into the volume at first init. So
# after editing infra/keycloak/realm-andyur.json, or rotating the ANDYUR_IDP_*
# secrets in data/docker.env, run `./run.sh idp reset` (wipes IdP state) --
# a plain restart silently keeps the old realm and the old password.

# --- tool egress -------------------------------------------------------------
# A run's managed tool calls (those to a server declaring `andyur.authority`)
# go through the per-run sidecar (andyur/proxy, ADR 003): it strips the agent's
# headers, mints an audience-scoped RFC 8693 token, and presents the run's
# X509-SVID over mTLS. It is Andyur code, so there is no broker binary to
# install -- but it REQUIRES the SPIRE Workload API for the X509-SVID; without
# one, every managed tool is withheld, fail closed.
#
# There is no egress to choose: the transitional per-run agentgateway was
# removed once the sidecar passed every live gate. ANDYUR_TOOL_EGRESS is no
# longer a setting -- a leftover `agentgateway` value is refused at startup
# rather than silently ignored.

# --- external-AS scope vocabulary (ADR-010) ----------------------------------
# When an external Authorization Server governs tool authority, it speaks its
# OWN scope vocabulary (e.g. telemetry:read), not Andyur's logical registry
# actions (e.g. obs:read). The translation is needed in TWO places, kept in sync:
#
#   ANDYUR_AS_RESOURCE_SCOPE  the REQUEST side, on the runner/sidecar: a JSON
#     reference-scope-map that translates each logical action into what to ask
#     the AS for at exchange time, e.g.
#       {"schema":"andyur-reference-scope-map/v1","actions":{
#          "obs:read":{"request":"telemetry:read","claim":"telemetry:read"}}}
#     The map is STRICT: an action with no entry fails the whole exchange loudly.
#
#   ANDYUR_TOOL_SCOPE_MAP     the ENFORCEMENT side, on each resource server: a
#     JSON logical->AS map so the tool PEP checks the AS scope the issued token
#     actually carries, e.g. {"obs:read":"telemetry:read"}. Empty (the default)
#     leaves the tool enforcing the logical action -- correct for the local mint,
#     WRONG behind an external AS, where every tool call is then silently refused
#     ("token permits telemetry:read, not obs:read"). If you wire an external AS,
#     set BOTH: the request map so the AS issues its vocabulary, and the tool map
#     so the PEP enforces the same vocabulary. (They are two views of one fact;
#     a future revision should derive one from the other -- for now, keep them
#     consistent by hand.)
