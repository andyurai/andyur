# The control-plane configuration the FEDERATED demo needs.
#   source demos/enterprise/federated.env && ./run.sh server
#
# Every line is configuration of EXISTING platform behaviour. Nothing here
# changes the platform; it turns on controls that ship switched off.
export ANDYUR_PROFILE=dev            # prod refuses to self-sign; an external AS mints there
export ANDYUR_OTEL=on
export ANDYUR_GRAPH=neo4j
export ANDYUR_LLM=ollama
export ANDYUR_AGENT_AUTH=on
export ANDYUR_AGENT_MODEL=qwen3-andyur:latest
export ANDYUR_ALLOW_UNISOLATED_AGENT=on

# THE IdP IS AUTHORITATIVE. With this on, `acting_user` can no longer be
# asserted -- the platform refuses it -- and every run inherits a real login.
export ANDYUR_USER_AUTH=on
export ANDYUR_OIDC_ISSUER="http://127.0.0.1:8480/realms/andyur"
export ANDYUR_OIDC_JWKS="http://127.0.0.1:8480/realms/andyur/protocol/openid-connect/certs"
export ANDYUR_OIDC_AUDIENCE="andyur"
# Unset means NOBODY is admin (fail closed). David holds this realm role.
export ANDYUR_ADMIN_ROLE="andyur-admin"

# Without this the platform generates a fresh signing key PER PROCESS under the
# same `kid`, and every resource server holding the other copy returns 401.
export ANDYUR_EXCHANGE_KEY="$PWD/data/secrets/exchange-key.pem"

# WHICH CLAIM IS THE USER. Default `sub` is a Keycloak UUID, so the audit trail
# and every downstream resource server name `f78382c2-...` instead of a person.
# Keycloak's `preferred_username` is immutable here, so it is safe to use.
# Changing this ORPHANS agents owned under the old identifier -- the platform
# warns about ownerless agents at startup.
export ANDYUR_OIDC_SUBJECT_CLAIM=preferred_username
